# Django
SECRET_KEY="sua-secret-key-aqui"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1"

# PostgreSQL
DB_NAME="nome_do_banco"
DB_USER="usuario_do_banco"
DB_PASSWORD="senha_do_banco"
DB_HOST="localhost"
DB_PORT="5432"

# Seguranca em producao (usado apenas quando DEBUG=False)
# Comece com 3600 e aumente para 31536000 apos confirmar o HTTPS estavel.
SECURE_HSTS_SECONDS=3600

# Redis (camada de canais do Django Channels)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB_CHANNELS=1
REDIS_DB_CACHE=2

# Email
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
DEFAULT_FROM_EMAIL="nao-responda@seu-dominio.com"

# Busca semantica do forum.
#
# Desligada por padrao. Ligar exige, alem desta variavel:
#   pip install -r requirements-ia.txt
#   sudo apt install postgresql-14-pgvector
#   sudo -u postgres psql -d template1 -c "CREATE EXTENSION IF NOT EXISTS vector;"
#
# Sem ela a busca do forum responde por correspondencia de termos, e nenhuma
# outra tela e afetada.
BUSCA_SEMANTICA_ATIVA=False
